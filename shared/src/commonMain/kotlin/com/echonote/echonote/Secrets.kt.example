package com.echonote.echonote

/**
 * ŞABLON: Bu dosyayı "Secrets.kt" olarak kopyala ve kendi değerlerini yapıştır.
 * Secrets.kt .gitignore'dadır, asla commit'lenmez.
 *
 * Buradaki iki değer de **gizli değildir**: Supabase anon anahtarı istemciye gömülmek
 * üzere tasarlanmıştır ve onu güvenli kılan şey Row Level Security'dir (supabase/schema.sql).
 * Gerçek sırlar (Gemini API anahtarı) uygulama içindeki Ayarlar ekranından girilir ve
 * yalnızca cihazda saklanır — binary'de sır taşımıyoruz.
 *
 * Değerler boş bırakılırsa uygulama çevrimdışı moda düşer: kimlik doğrulama ve senkron
 * olmadan, yalnızca yerel SQLite deposuyla çalışır (notlar yine kalıcıdır).
 */
object Secrets {
    /** Supabase proje URL'i, örn. "https://abcdefgh.supabase.co" */
    const val SUPABASE_URL: String = ""

    /** Supabase Dashboard → Settings → API → anon/public anahtarı. */
    const val SUPABASE_ANON_KEY: String = ""
}
