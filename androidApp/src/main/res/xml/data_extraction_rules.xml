<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ karşılığı. Gerekçe backup_rules.xml ile aynı: yerel veritabanı bu
    cihazın önbelleği, kimlik bilgileri de taşınmamalı.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="echonote.db" />
        <exclude domain="database" path="echonote.db-journal" />
        <exclude domain="sharedpref" path="com.echonote.echonote_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="echonote.db" />
        <exclude domain="database" path="echonote.db-journal" />
        <exclude domain="sharedpref" path="com.echonote.echonote_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
