-- EchoNote yerel deposu. Tek gerçek kaynak budur; Supabase senkron katmanıdır.
--
-- dirty / pending_delete, Adım 1'de ViewModel belleğinde tutulan senkron defterinin
-- kalıcı hâli: bekleyen iş artık cihaz yeniden başlasa bile kaybolmaz.
--
-- SQL bilerek SQLite 3.18 temelinde: upsert (ON CONFLICT DO UPDATE) 3.24+ istiyor,
-- Android'de bu API 30+ demek, minSdk ise 24. Koşullu yazma Kotlin tarafında
-- transaction içinde yapılıyor (NotesLocalStore).

CREATE TABLE note (
    id             TEXT NOT NULL PRIMARY KEY,
    title          TEXT NOT NULL,
    content        TEXT NOT NULL,
    updated_at     TEXT NOT NULL,
    device_id      TEXT NOT NULL,
    dirty          INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    pending_delete INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    -- Dolu ise not COP KUTUSUNDA. pending_delete'ten farki: bu normal bir alan gibi
    -- SENKRONLANIR, yani cop kutusu iki cihazda da ayni gorunur. pending_delete ise
    -- kalici silmenin outbox tombstone'u olarak kaliyor.
    deleted_at     TEXT
);

CREATE INDEX note_updated_at ON note(updated_at DESC);

-- --- Okuma ---

-- UI'ın gördüğü liste: tombstone'lar ve çöp kutusundakiler görünmez.
selectVisible:
SELECT * FROM note WHERE pending_delete = 0 AND deleted_at IS NULL ORDER BY updated_at DESC;

-- Çöp kutusu: silinme zamanına göre yeniden eskiye.
selectTrashed:
SELECT * FROM note WHERE pending_delete = 0 AND deleted_at IS NOT NULL ORDER BY deleted_at DESC;

countTrashed:
SELECT count(*) FROM note WHERE pending_delete = 0 AND deleted_at IS NOT NULL;

-- Otomatik temizlik adaylari: cop kutusunda verilen tarihten eski olanlar.
selectTrashedBefore:
SELECT id FROM note WHERE deleted_at IS NOT NULL AND deleted_at < ?;

selectById:
SELECT * FROM note WHERE id = ?;

-- Uzak listede olmayanları silmek için: yalnızca senkron olmuş satırlar adaydır,
-- bekleyen iş taşıyanlara dokunulmaz (henüz push edilmemiş yeni not olabilir).
selectCleanIds:
SELECT id FROM note WHERE dirty = 0 AND pending_delete = 0;

-- Outbox: uzağa gönderilmeyi bekleyen her şey.
selectPendingPush:
SELECT * FROM note WHERE dirty = 1 OR pending_delete = 1;

countPendingPush:
SELECT count(*) FROM note WHERE dirty = 1 OR pending_delete = 1;

-- --- Yazma ---

insertNote:
INSERT INTO note(id, title, content, updated_at, device_id, dirty, pending_delete, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateNoteRow:
UPDATE note
SET title = ?, content = ?, updated_at = ?, device_id = ?, dirty = ?, deleted_at = ?
WHERE id = ?;

-- Cop kutusuna tasima / geri alma. Ikisi de satiri KIRLI isaretler: deleted_at normal
-- bir alan gibi senkronlanir, boylece cop kutusu iki cihazda da ayni gorunur.
moveToTrash:
UPDATE note SET deleted_at = ?, updated_at = ?, dirty = 1 WHERE id = ?;

restoreFromTrash:
UPDATE note SET deleted_at = NULL, updated_at = ?, dirty = 1 WHERE id = ?;

-- Kalici silme: uzaga silme emri gondermek icin tombstone.
markPendingDelete:
UPDATE note SET pending_delete = 1 WHERE id = ?;

-- Sürüm korumalı temizleme: Adım 1'deki updated_at karşılaştırmasının atomik SQL hâli.
-- Uzağa yazarken kullanıcı yazmaya devam ettiyse updated_at değişmiş olur ve satır
-- kirli kalır — böylece yeni harfler bir sonraki push'ta gönderilir.
clearDirtyIfUnchanged:
UPDATE note SET dirty = 0 WHERE id = ? AND updated_at = ?;

deleteHard:
DELETE FROM note WHERE id = ?;

-- Çıkışta: bir sonraki hesap öncekinin notlarını görmesin.
deleteAll:
DELETE FROM note;
