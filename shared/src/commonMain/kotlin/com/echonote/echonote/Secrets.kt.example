package com.echonote.echonote

/**
 * ŞABLON: Bu dosyayı "Secrets.kt" olarak kopyala ve kendi anahtarlarını yapıştır.
 * Secrets.kt .gitignore'dadır, asla commit'lenmez.
 *
 * Değerler boş bırakılırsa uygulama otomatik olarak çevrimdışı moda düşer:
 * sahte AI + bellek içi not deposu ile çalışmaya devam eder.
 */
object Secrets {
    /** https://aistudio.google.com/apikey adresinden alınan Gemini API anahtarı. */
    const val GEMINI_API_KEY: String = ""

    /** Supabase proje URL'i, örn. "https://abcdefgh.supabase.co" */
    const val SUPABASE_URL: String = ""

    /** Supabase Dashboard → Settings → API → anon/public anahtarı. */
    const val SUPABASE_ANON_KEY: String = ""
}
